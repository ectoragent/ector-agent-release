{
  "name": "@ector/ink",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "OpenTUI-backed drop-in for the legacy @ector/ink API",
  "scripts": {
    "build": "node scripts/bundle.mjs"
  },
  "sideEffects": true,
  "files": [
    "dist",
    "index.js",
    "index.d.ts"
  ],
  "main": "./index.js",
  "types": "./index.d.ts",
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "import": "./index.js",
      "default": "./index.js"
    },
    "./package.json": "./package.json"
  },
  "dependencies": {
    "@opentui/core": "^0.2.14",
    "@opentui/react": "^0.2.14",
    "react": ">=19.0.0",
    "strip-ansi": "^7.1.0"
  },
  "peerDependencies": {
    "react": ">=19.0.0"
  },
  "devDependencies": {
    "esbuild": "^0.27.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  }
}
