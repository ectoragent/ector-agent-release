{
  "name": "ector-tui",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "pnpm -C packages/ector-tui run build && bun --watch src/entry.tsx",
    "start": "bun src/entry.tsx",
    "build": "pnpm -C packages/ector-tui run build && tsc -p tsconfig.build.json && pnpm run build:compile && chmod +x dist/entry.js",
    "build:compile": "babel dist --out-dir dist --config-file ./babel.compiler.config.cjs --extensions .js --keep-file-extension",
    "type-check": "tsc --noEmit -p tsconfig.json",
    "lint": "eslint src/ packages/",
    "lint:fix": "eslint src/ packages/ --fix",
    "fmt": "prettier --write 'src/**/*.{ts,tsx}' 'packages/**/*.{ts,tsx}'",
    "fix": "pnpm run lint:fix && pnpm run fmt",
    "test": "vitest run",
    "test:watch": "vitest",
    "spike:opentui": "bun src/spike/opentuiSpike.tsx",
    "spike:layout": "bun src/spike/layoutSmoke.tsx",
    "spike:compat": "pnpm -C packages/ector-tui run build && bun src/spike/compatLayoutSmoke.tsx"
  },
  "dependencies": {
    "@ector/ink": "file:./packages/ector-tui",
    "@nanostores/react": "^1.1.0",
    "nanostores": "^1.3.0",
    "react": "^19.2.4"
  },
  "devDependencies": {
    "@opentui/core": "^0.2.14",
    "@opentui/react": "^0.2.14",
    "@babel/cli": "^7.28.6",
    "@babel/core": "^7.29.0",
    "@babel/plugin-syntax-jsx": "^7.28.6",
    "@eslint/js": "^9",
    "@types/node": "^25.5.0",
    "@types/react": "^19.2.14",
    "@typescript-eslint/eslint-plugin": "^8",
    "@typescript-eslint/parser": "^8",
    "babel-plugin-react-compiler": "^1.0.0",
    "esbuild": "^0.27.0",
    "eslint": "^9",
    "eslint-plugin-perfectionist": "^5",
    "eslint-plugin-react": "^7",
    "eslint-plugin-react-compiler": "^19.1.0-rc.2",
    "eslint-plugin-react-hooks": "^7",
    "eslint-plugin-unused-imports": "^4",
    "globals": "^16",
    "prettier": "^3",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0",
    "vitest": "^4.1.3"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  }
}
